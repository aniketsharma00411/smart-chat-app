    classDef firebaseClass fill:#ff6f00,stroke:#333,stroke-width:2px,color:#fff
    classDef gcpClass fill:#ea4335,stroke:#333,stroke-width:2px,color:#fff
    classDef infraClass fill:#607d8b,stroke:#333,stroke-width:2px,color:#fff
    classDef devClass fill:#37474f,stroke:#333,stroke-width:2px,color:#fff
    
    class Browser userClass
    class FirebaseCDN,StaticAssets hostingClass
    class Caddy,DockerContainer,FastAPIApp,PythonRuntime,EnvVars,RequirementsTxt appClass
    class FirebaseAuth,CloudFirestore,FirebaseSDK firebaseClass
    class GeminiAPI,SpeechAPI,TTSAPI,TranslateAPI,GCPProject gcpClass
    class Terraform,TfState,TfVars infraClass
